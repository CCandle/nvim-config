global !p
import vim

# 在 Neovim 中注入 Lua 函数（去除 Vimscript 的 heredoc 语法，直接传纯 Lua 代码）
if int(vim.eval("has('nvim')")) == 1:
    try:
        # pynvim 原生的执行 Lua 代码的方法，最为安全
        vim.exec_lua("""
        if _G.in_markdown_mathzone == nil then
            _G.in_markdown_mathzone = function()
                local ok, ts = pcall(require, 'vim.treesitter')
                if not ok then return false end
                
                -- 兼容 Neovim 0.8 及 0.9+
                local node
                if ts.get_node then
                    node = ts.get_node()
                elseif ts.get_node_at_cursor then
                    node = ts.get_node_at_cursor()
                end
                
                while node do
                    local t = node:type()
                    -- 匹配各种 Markdown 和 LaTeX 的 Treesitter 数学节点类型
                    if t == 'math_environment' or t == 'math_block' or t == 'inline_formula' or t == 'displayed_equation' or t == 'latex_block' then
                        return true
                    end
                    node = node:parent()
                end
                return false
            end
        end
        """)
    except AttributeError:
        # 兼容极老版本的 pynvim 备用方案
        vim.command("""lua
        if _G.in_markdown_mathzone == nil then
            _G.in_markdown_mathzone = function()
                local ok, ts = pcall(require, 'vim.treesitter')
                if not ok then return false end
                local node
                if ts.get_node then node = ts.get_node()
                elseif ts.get_node_at_cursor then node = ts.get_node_at_cursor() end
                while node do
                    local t = node:type()
                    if t == 'math_environment' or t == 'math_block' or t == 'inline_formula' or t == 'displayed_equation' or t == 'latex_block' then return true end
                    node = node:parent()
                end
                return false
            end
        end
        """)

def math():
    # 1. 尝试使用 Vimtex 自身的检测
    try:
        if vim.eval("exists('*vimtex#syntax#in_mathzone')") == '1':
            if vim.eval("vimtex#syntax#in_mathzone()") in ('1', 1):
                return True
    except Exception:
        pass

    # 2. 尝试使用 Treesitter 检测
    if int(vim.eval("has('nvim')")) == 1:
        try:
            if vim.eval("v:lua.in_markdown_mathzone()") in (True, 1, '1'):
                return True
        except Exception:
            pass

    # 3. 尝试使用传统的 Vim Syntax 检测
    try:
        col = max([1, int(vim.eval("col('.')")) - 1])
        syn = vim.eval(f"synIDattr(synID(line('.'), {col}, 1), 'name')")
        if syn and any(x in syn.lower() for x in ['math', 'tex', 'mkd', 'pandoc']):
            return True
    except Exception:
        pass

    # 4. 纯文本逻辑兜底
    # 注意：Vim 的 col('.') 返回字节列，不是字符列。
    # 如果直接用 Python 的 line[:col]，遇到中文等多字节字符会切错位置，
    # 进而把右侧的 '$' 误算进去，导致数学区判断失效。
    try:
        buf = vim.current.buffer
        row, _ = vim.current.window.cursor
        
        block_count = 0
        for i in range(row - 1):
            clean_line = buf[i].replace("\\$", "")
            block_count += clean_line.count("$$")
            
        if block_count % 2 == 1:
            return True
        
        line = vim.eval("getline('.')")
        before_cursor = vim.eval("strpart(getline('.'), 0, col('.') - 1)")
        before_cursor = before_cursor.replace("\\$", "")
        
        if before_cursor.count("$$") % 2 == 1:
            return True
            
        before_cursor_clean = before_cursor.replace("$$", "")
        if before_cursor_clean.count("$") % 2 == 1:
            return True
            
    except Exception:
        pass

    return False

def not_math():
    return not math()
endglobal


