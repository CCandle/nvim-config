global !p
def math():
	return vim.eval('vimtex#syntax#in_mathzone()') == '1'

def comment(): 
	return vim.eval('vimtex#syntax#in_comment()') == '1'

def env(name):
	[x,y] = vim.eval("vimtex#env#is_inside('" + name + "')") 
	return x != '0' and y != '0'

endglobal

priority 300
snippet beg "begin{} / end{}" bA
\begin{$1}
	$0
\end{$1}
endsnippet

snippet part "part" bA
\part{$1}
$0
endsnippet

snippet sec "section" bA
\section{$1}
$0
endsnippet

snippet ssec "subsection" bA
\subsection{$1}
$0
endsnippet

snippet sssec "subsubsection" bA
\subsubsection{$1}
$0
endsnippet

snippet para "paragraph" bA
\paragraph{$1}

$0
endsnippet

snippet spara "sub paragraph" bA
\subparagraph{$1}~{}\\\\
$0
endsnippet

snippet reft "Autoref table" wA
\autoref{tab:${1:${VISUAL}}} $0
endsnippet

snippet reff "Autoref figure" wA
\autoref{fig:${1:${VISUAL}}} $0
endsnippet

snippet refe "Autoref equation" wA
\autoref{eq:${1:${VISUAL}}} $0
endsnippet

snippet table "Table environment" b
\begin{table}[${1:htpb}]
	\centering
	\caption{${2:caption}}
	\label{tab:${3:label}}
	\begin{tabular}{${5:c}}
	$0${5/((?<=.)c|l|r)|./(?1: & )/g}
	\end{tabular}
\end{table}
endsnippet

snippet tabx "Tabularx environment" b
\begin{table}[${1:htpb}]
	\centering
	\caption{${2:caption}}
	\label{tab:${3:label}}
	\begin{tabularx}{\textwidth}{${5:c}}
	$0${5/((?<=.)c|l|r)|./(?1: & )/g}
	\end{tabularx}
\end{table}
endsnippet

snippet fig "Figure environment" b
\begin{figure}[${1:H}]
	\centering
	\includegraphics[width=${4:0.8}\textwidth]{$3}
	\caption{${5:$3}}
	\label{fig:${3/\W+/-/g}}
\end{figure}
endsnippet

snippet enum "Enumerate" b
\begin{enumerate}
	\item $0
\end{enumerate}
endsnippet

snippet item "Itemize" b
\begin{itemize}
	\item $0
\end{itemize}
endsnippet

snippet desc "Description" b
\begin{description}
	\item[$1] $0
\end{description}
endsnippet

snippet def "Definition" b
\begin{definition}[$1]
	$0
\end{definition}
endsnippet

snippet theo "Theorem" b
\begin{theorem}[$1]
	$0
\end{theorem}
endsnippet

snippet lem "Lemma" b
\begin{lemma}[$1]
	$0
\end{lemma}
endsnippet

snippet cor "Corollary" b
\begin{corollary}
	$0
\end{corollary}
endsnippet

snippet eg "Example" b
\begin{example}
	$0
\end{example}
endsnippet

snippet pac "Package" b
\usepackage[${1:options}]{${2:package}}$0
endsnippet

snippet plot "Plot" w
\begin{figure}[$1]
	\centering
	\begin{tikzpicture}
		\begin{axis}[
			xmin= ${2:-10}, xmax= ${3:10},
			ymin= ${4:-10}, ymax = ${5:10},
			axis lines = middle,
		]
			\addplot[domain=$2:$3, samples=${6:100}]{$7};
		\end{axis}
	\end{tikzpicture}
	\caption{$8}
	\label{${9:$8}}
\end{figure}
endsnippet

snippet nn "Tikz node" w
\node[$5] (${1/[^0-9a-zA-Z]//g}${2}) ${3:at (${4:0,0}) }{$${1}$};
$0
endsnippet

snippet SI "SI" iA
\SI{$1}{$2}
endsnippet

snippet letw "let omega" iA
Let $\Omega \subset \C$ be open.
endsnippet

context "env("enumerate")"
snippet ii "item" iA
\item
endsnippet

context "env("itemize")"
snippet ii "item" iA
\item
endsnippet

snippet wfig "wrapigure " b
\begin{wrapfigure}{r}{${1:0.3}\textwidth}
	\centering
	\includegraphics[width=\linewidth]{$2}
	\caption{${3:$2}}
	\label{fig:${2/\W+/-/g}}
\end{wrapfigure}
$0
endsnippet