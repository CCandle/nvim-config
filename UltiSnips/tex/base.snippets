global !p
def math():
	return vim.eval('vimtex#syntax#in_mathzone()') == '1'

def comment(): 
	return vim.eval('vimtex#syntax#in_comment()') == '1'

def env(name):
	[x,y] = vim.eval("vimtex#env#is_inside('" + name + "')") 
	return x != '0' and y != '0'

endglobal

priority 300
snippet beg "begin{} / end{}" bA
\begin{$1}
	$0
\end{$1}
endsnippet

snippet part "part" bA
\part{$1}
$0
endsnippet

snippet chap "chapter" bA
\chapter{$1}
$0
endsnippet

snippet sec "section" bA
\section{$1}
$0
endsnippet

snippet ssec "subsection" bA
\subsection{$1}
$0
endsnippet

snippet sssec "subsubsection" bA
\subsubsection{$1}
$0
endsnippet

# 文本区加粗：math 区里不触发（数学里用 \mathbf 等）
context "not math()"
snippet bf "bold text" w
\textbf{$1}$0
endsnippet

snippet para "paragraph" bA
\paragraph{$1}

$0
endsnippet

snippet spara "sub paragraph" bA
\subparagraph{$1}
$0
endsnippet

# 行内关键词：\keyword{}（CarlosTeal 绿色小标签）；math 区里不触发；支持 visual 包词
context "not math()"
snippet KW "keyword" iA
\keyword{${1:${VISUAL}}}$0
endsnippet

snippet reft "Autoref table" wA
\autoref{tab:${1:${VISUAL}}} $0
endsnippet

snippet reff "Autoref figure" wA
\autoref{fig:${1:${VISUAL}}} $0
endsnippet

snippet refe "Autoref equation" wA
\autoref{eq:${1:${VISUAL}}} $0
endsnippet

snippet table "Table environment" b
\begin{table}[${1:htpb}]
	\centering
	\caption{${2:caption}}
	\label{tab:${3:label}}
	\begin{tabular}{${5:c}}
	$0${5/((?<=.)c|l|r)|./(?1: & )/g}
	\end{tabular}
\end{table}
endsnippet

snippet tabx "Tabularx environment" b
\begin{table}[${1:htpb}]
	\centering
	\caption{${2:caption}}
	\label{tab:${3:label}}
	\begin{tabularx}{\textwidth}{${5:c}}
	$0${5/((?<=.)c|l|r)|./(?1: & )/g}
	\end{tabularx}
\end{table}
endsnippet

snippet fig "Figure environment" b
\begin{figure}[${1:H}]
	\centering
	\includegraphics[width=${4:0.8}\textwidth]{$3}
	\caption{${5:$3}}
	\label{fig:${3/\W+/-/g}}
\end{figure}
endsnippet

snippet enum "Enumerate" b
\begin{enumerate}
	\item $0
\end{enumerate}
endsnippet

snippet item "Itemize" b
\begin{itemize}
	\item $0
\end{itemize}
endsnippet

snippet desc "Description" b
\begin{description}
	\item[$1] $0
\end{description}
endsnippet

# --- 数学笔记环境（对应 CarlosTexNote.cls） ----------------------------------
# 统一规则：行首触发、Tab 展开；正文写完后按 Tab 跳到 \end{...} 之后。

snippet def "定义" b
\begin{definition}[$1]
	$2
\end{definition}
$0
endsnippet

snippet thm "定理" b
\begin{theorem}[$1]
	$2
\end{theorem}
$0
endsnippet

snippet prp "性质" b
\begin{property}[$1]
	$2
\end{property}
$0
endsnippet

snippet cor "推论" b
\begin{corollary}[$1]
	$2
\end{corollary}
$0
endsnippet

snippet lem "引理" b
\begin{lemma}[$1]
	$2
\end{lemma}
$0
endsnippet

snippet pro "命题" b
\begin{proposition}[$1]
	$2
\end{proposition}
$0
endsnippet

snippet rem "注" b
\begin{remark}[$1]
	$2
\end{remark}
$0
endsnippet

snippet eg "例题" b
\begin{example}[$1]
	$2
\end{example}
$0
endsnippet

snippet sol "解答" b
\begin{solution}
	$1
\end{solution}
$0
endsnippet

snippet egs "例题 + 解答" b
\begin{example}[$1]
	$2
\end{example}

\begin{solution}
	$3
\end{solution}
$0
endsnippet

snippet pf "证明" b
\begin{proof}[$1]
	$2
\end{proof}
$0
endsnippet

# --- 非编号 callout（markdown callout 风格） ---------------------------------

snippet key "重点" b
\begin{keybox}[$1]
	$2
\end{keybox}
$0
endsnippet

snippet warn "易错" b
\begin{warningbox}[$1]
	$2
\end{warningbox}
$0
endsnippet

snippet mthd "方法" b
\begin{methodbox}[$1]
	$2
\end{methodbox}
$0
endsnippet

snippet smry "小结" b
\begin{summarybox}[$1]
	$2
\end{summarybox}
$0
endsnippet

# --- 主动回忆 / 易错辨析（CarlosTexNote v0.2.0） -----------------------------

snippet recall "闭卷提取" b
\begin{recallbox}[${1:闭卷提取}]
	$2
\end{recallbox}
$0
endsnippet

# mist 是 warningbox 的易错辨析别名；原有 warn 触发词保持不变。
snippet mist "易错辨析" b
\begin{warningbox}[${1:易错辨析}]
	$2
\end{warningbox}
$0
endsnippet

snippet pac "Package" b
\usepackage[${1:options}]{${2:package}}$0
endsnippet

snippet plot "Plot" w
\begin{figure}[$1]
	\centering
	\begin{tikzpicture}
		\begin{axis}[
			xmin= ${2:-10}, xmax= ${3:10},
			ymin= ${4:-10}, ymax = ${5:10},
			axis lines = middle,
		]
			\addplot[domain=$2:$3, samples=${6:100}]{$7};
		\end{axis}
	\end{tikzpicture}
	\caption{$8}
	\label{${9:$8}}
\end{figure}
endsnippet

snippet nn "Tikz node" w
\node[$5] (${1/[^0-9a-zA-Z]//g}${2}) ${3:at (${4:0,0}) }{$${1}$};
$0
endsnippet

snippet SI "siunitx quantity" iA
\qty{$1}{$2}$0
endsnippet

snippet letw "let omega" iA
Let $\Omega \subset \C$ be open.
endsnippet

context "env("enumerate")"
snippet ii "item" iA
\item
endsnippet

context "env("itemize")"
snippet ii "item" iA
\item
endsnippet

snippet wfig "wrapigure " b
\begin{wrapfigure}{r}{${1:0.3}\textwidth}
	\centering
	\includegraphics[width=\linewidth]{$2}
	\caption{${3:$2}}
	\label{fig:${2/\W+/-/g}}
\end{wrapfigure}
$0
endsnippet